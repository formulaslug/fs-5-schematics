	(text "Tau = 1/f_sample = 1/20kHz = 0.00005\nRC = 0.00005\nR = 470R\nC = 0.0005/470 = 0.0000001064 = ~0.1uF\n\nTotal current draw of op amp and RCs:\n5v/(sqrt(470R^2 + (1/(2 * pi * 20kHz * 0.1uF))^2)) = 10.49mA * 4 = 41.96 mA\n5v/(sqrt(10kR^2 + (1/(2 * pi * 1Hz * 100uF))^2)) = 0.5 mA\n\n41.96 mA + 0.5 mA = 42.46 mA"
		(exclude_from_sim no)
		(at 213.36 129.286 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fdb55281-d08b-4665-8fff-c8be8ba75d72")
	)
